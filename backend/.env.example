# ─────────────────────────────────────────────────────────────
# Echo Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# General settings
PROJECT_NAME="Echo Speech Translation Backend"
API_V1_STR="/api/v1"

# CORS origins (comma-separated or JSON array)
# Production: set to your Vercel frontend URL, e.g. https://echo-app.vercel.app
BACKEND_CORS_ORIGINS="*"

# ── AI Model configuration ────────────────────────────────────
# Whisper ASR: 'tiny' for free tier (512 MB RAM), 'base' or 'small' for paid plans
WHISPER_MODEL_NAME="tiny"

# Gemini Flash API key for cloud-based translation
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Hugging Face ──────────────────────────────────────────────
# Disable Xet CDN (requires auth even for public models)
HF_HUB_DISABLE_XET=1

# ── Database Configuration ─────────────────────────────────────
# Local dev: SQLite (zero install, no Docker needed)
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///./speech_translation.db

# Production (Render): set DATABASE_URL to your PostgreSQL connection string
# e.g. postgresql://user:password@dpg-xxx.render.com/mydb
# DATABASE_URL=postgresql://toxiguard_db_s3ld_user:password@dpg-da7ar0navr4c73bga9vg-a/toxiguard_db_s3ld
