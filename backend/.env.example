# General settings
PROJECT_NAME="Echo Speech Translation Backend"
API_V1_STR="/api/v1"

# CORS origins separated by commas or JSON array
# e.g. http://localhost:3000,http://192.168.1.100
BACKEND_CORS_ORIGINS="*"

# Placeholder models configuration
WHISPER_MODEL_NAME="base"
TRANSLATION_MODEL_NAME="facebook/nllb-200-distilled-600M"
TTS_MODEL_NAME="suno/bark-small"

# Database Configuration
# Render PostgreSQL (sets DATABASE_URL automatically in Render dashboard):
# DATABASE_URL=postgresql://user:password@hostname/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=speech_translation
