# =============================================================================
# .env.production — PRODUCTION SECRETS
# =============================================================================
# ⚠️  NEVER COMMIT THIS FILE TO GIT
# ⚠️  This file is listed in .gitignore
# ⚠️  Copy this template to the VM and fill in real values
#
# On the Oracle VM:
#   nano ~/capstron/backend/.env.production
#   chmod 600 ~/capstron/backend/.env.production   # only owner can read
# =============================================================================

# General settings
PROJECT_NAME="Speech Translation Backend"
API_V1_STR="/api/v1"

# CORS — restrict to your domain in production
# (Replace with actual origin, e.g. https://api.capstron.example.com)
BACKEND_CORS_ORIGINS=["https://YOUR_DOMAIN"]

# AI Model configuration
WHISPER_MODEL_NAME="base"
TRANSLATION_MODEL_NAME="facebook/nllb-200-distilled-600M"
TTS_MODEL_NAME="suno/bark-small"

# Hugging Face
HF_HUB_DISABLE_XET=1

# =============================================================================
# PostgreSQL — CHANGE THESE (never use "postgres"/"postgres" in production)
# =============================================================================
POSTGRES_USER=capstron_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_HOST=db              # Docker service name — do not change
POSTGRES_PORT=5432
POSTGRES_DB=speech_translation
